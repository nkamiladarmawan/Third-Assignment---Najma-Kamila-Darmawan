/* 
- Pertama, saya mencari pola fungsi lainnya terlebih dahulu
f(1) = 1
f(2) = (2/2)*1
f(3) = 3*(2/2)*1
f(4) = (4/2)*3*(2/2)*1
f(5) = 5*(4/2)*3*(2/2)*1
f(6) = (6/2)*5*(4/2)*3*(2/2)*1
f(7) = 7*(6/2)*5*(4/2)*3*(2/2)*1

- Kedua, saya coba mencari hubungan pola fungsi dengan n pada f(n)
f(1) = 1
f(2) = (n/2)*1
f(3) = n*f(n-1)
f(4) = (n/2)*f(n-1)

- Ketiga, saya mencari pola untuk fungsi dengan n ganji dan genap
genap = (n/2)*f(n-1)
ganjil = n*f(n-1)

jika angka tersebut genap, nilainya dibagi 2 terlebih dahulu sebelum dikalikan. Jika angka tersebut ganjil, nilainya langsung dikalikan tanpa dibagi.

*/

#include<iostream>
using namespace std;

long long rekursif(int x){
	if(x == 1){
		return 1;
	} else if (x%2 == 0){
		return (x/2)*rekursif(x-1);
	} else if (x%2 == 1){
		return x*rekursif(x-1);
	}
}

int main (){
	int angka;
	
	cout << "Masukkan angka yang anda inginkan: ";
	cin >> angka;
	
	cout << "fungsi rekursif f(" << angka <<") : ";
	cout << rekursif(angka);
	
}